# Base URL of the NestJS API. Defaults to http://localhost:3001 when unset.
VITE_API_BASE_URL=http://localhost:3001

# Set to "true" to start the MSW worker and let query hooks short-circuit to
# their mockData. Off by default so development runs against the real API.
VITE_ENABLE_MOCKS=false

# localStorage / sessionStorage key names. Suffix with the environment so
# Dev, Staging and Prod sessions on the same origin do not collide, and so
# keys are identifiable in the browser Application tab.
VITE_AUTH_STORAGE_KEY=StyleSync_Auth_Dev
VITE_THEME_STORAGE_KEY=StyleSync_Theme_Dev
VITE_I18N_STORAGE_KEY=StyleSync_I18n_Dev
