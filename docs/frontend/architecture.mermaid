graph TD
    subgraph "Client Layer (Browser)"
        UI[React UI - shadcn/ui]
        Router[TanStack Router]
        Store[Zustand Store]
        Context[Constate/Local Context]
        Query[TanStack Query]
        Login[Login Screen Modules]
        Register[Register Screen Modules]
        Toaster[Toaster / notify]
    end

    subgraph "Login Composition"
        Banner[Banner lg+]
        FormView[LoginFormView]
        ViewTransition[ViewTransition]
        FormElements[FormElements.Input]
    end

    subgraph "Register Composition"
        RegisterBanner[Register Banner lg+]
        RegisterForm[RegisterFormView]
        LinkDialog[LinkAccountDialog 428]
    end

    subgraph "Data & Logic Layer"
        API[Domain API Hooks]
        Facades[useQuery / useMutation]
        Request[request + errorTreatment]
        Env[utils/env]
        Jwt[jwt.util]
        Redirect[isSafeInternalPath]
        Mocks[MSW Mocks - VITE_ENABLE_MOCKS]
    end

    subgraph "External Services"
        Backend[NestJS Backend API]
        Storage[Local Storage StyleSync_Auth_Dev v2]
    end

    UI --> Router
    UI --> Store
    UI --> Context
    UI --> Query
    UI --> Login
    UI --> Register
    UI --> Toaster

    Router -->|ADMIN only| AdminHome[Admin layout guard]
    Login --> Banner
    Login --> FormView
    Register --> RegisterBanner
    Register --> RegisterForm
    Register --> LinkDialog
    FormView --> ViewTransition
    FormView --> FormElements
    RegisterForm --> FormElements

    Query --> API
    API --> Facades
    API --> Redirect
    Facades --> Request
    Facades --> Mocks
    Request --> Env
    Request --> Jwt
    FormView --> API
    Facades --> Toaster

    Request --> Backend
    Store --> Storage
    Store --> Jwt

    Backend -->|Theme Config| Store
    Store -->|CSS Variables| UI
